# Copy to .env and fill in. Never commit .env.

# Cloud provider (used only in cloud mode; snippets are sent, originals never leave the machine)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local runtime
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_CHAT_TIMEOUT=300
EMBED_DIM=1024

# Generation track: cloud | local
# New conversations start on this track; the UI can switch per conversation,
# and an explicit request override always wins. Nothing is locked.
DEFAULT_TRACK=cloud
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=localmind_chunks_v2

# Model storage (outside the repo; never commit model files)
OLLAMA_MODELS=D:\dev\models
HF_HOME=D:\dev\models\huggingface

# Storage
SQLITE_PATH=data/localmind.db

# Ingestion and retrieval (tuned in stage 2)
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
CHAT_HISTORY_TURNS=6

# Stage 2 retrieval: vector | hybrid | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_TOP_N=20
RRF_K=60
# Dense cosine threshold, used in vector mode and when rerank is unavailable
RETRIEVAL_MIN_SCORE=0.5
# Gate threshold; calibrated on eval/stage2/questions.jsonl (see ADR-0009)
RETRIEVAL_GATE_RERANK_SCORE=0.01

# Cross-encoder reranker (downloaded once into HF_HOME; local files only)
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Cloud track keeps the GPU copy; the local track reranks on CPU so it never
# competes with the local generation model for 8GB of VRAM.
RERANK_DEVICE=auto
RERANK_DEVICE_LOCAL=cpu
RERANK_BATCH_SIZE=8

# Stage 4 long-term memory
# Extraction follows the active track: cloud mode extracts with the cloud model
# (only your already-sent message is read), local mode extracts locally with
# zero egress. Embeddings are always local (bge-m3), so no memory text is sent.
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT=true
# Inject recalled memories into prompts; counted in the egress receipt.
MEMORY_INJECT=true
# Write a rolling conversation summary every N user messages (0 disables).
MEMORY_SUMMARY_EVERY=6
MEMORY_COLLECTION=localmind_memories
MEMORY_TOP_K=5
# Cosine threshold for recall; a matched memory can answer without documents.
MEMORY_MIN_SCORE=0.5
MEMORY_EXTRACT_TIMEOUT=120

# Server (localhost only)
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- docker compose only -----------------------------------------------------
# Mounted read-only into the backend container so the reranker does not need to
# be downloaded again (and never downloads inside the container). Point it at
# the same directory HF_HOME uses on the host, without the /hub suffix.
# HF_CACHE=D:/dev/models/huggingface
#
# The container reaches Ollama through host.docker.internal; see the README
# section "docker compose" for the one host setting that requires.
