# Copy to .env and fill in. Never commit .env.

# Cloud provider (used only in cloud mode; snippets are sent, originals never leave the machine)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local runtime
OLLAMA_HOST=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333

# Model storage (outside the repo; never commit model files)
OLLAMA_MODELS=D:\dev\models
HF_HOME=D:\dev\models\huggingface

# Retrieval defaults (tuned in stage 2)
RETRIEVAL_TOP_N=20
RETRIEVAL_TOP_K=5
REFUSAL_THRESHOLD=0.0