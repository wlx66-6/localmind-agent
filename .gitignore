data/local/
volumes/
*.sqlite3
*.db

# ---- Corpora (large / private) ----
# 只忽略仓库根目录下的私有大语料；examples/corpus 是公开演示语料，需要入库。
/corpus/
/corpora/
testdata/large/
testdata/private/

